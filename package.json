{
  "name": "siskiyou",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretty": "prettier --write 'src/**/*.ts'",
    "builddocs": "ng build --configuration production --base-href /siskiyou/demo/ && rimraf demo && copyfiles -u 2 dist/siskiyou/browser/** demo",
    "build:lib": "ng-packagr -p src/lib/ng-package.json -c src/lib/tsconfig.lib.json"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/localize": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "jszip": "^3.10.1",
    "moment": "^2.30.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@types/jasmine": "^5.1.9",
    "copyfiles": "^2.4.1",
    "jasmine-core": "^5.6.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3"
  }
}
